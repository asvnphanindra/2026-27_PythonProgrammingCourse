{"name":"Classroom Notebook","icon":"notebook","settings":"{\"window.zoomLevel\":0,\"workbench.startupEditor\":\"none\",\"workbench.sideBar.location\":\"left\",\"workbench.activityBar.location\":\"default\",\"workbench.editor.enablePreview\":false,\"workbench.statusBar.visible\":true,\"editor.fontSize\":24,\"editor.lineHeight\":36,\"editor.fontFamily\":\"Consolas, \\u0027Courier New\\u0027, monospace\",\"editor.mouseWheelZoom\":true,\"editor.minimap.enabled\":false,\"editor.wordWrap\":\"on\",\"editor.stickyScroll.enabled\":false,\"terminal.integrated.fontSize\":24,\"debug.console.fontSize\":24,\"notebook.markup.fontSize\":24,\"notebook.output.fontSize\":24,\"notebook.cellToolbarLocation\":{\"default\":\"right\",\"jupyter-notebook\":\"left\"},\"markdown.preview.fontSize\":24,\"files.autoSave\":\"afterDelay\",\"files.autoSaveDelay\":1000,\"explorer.compactFolders\":false,\"explorer.autoReveal\":true,\"extensions.ignoreRecommendations\":true,\"update.mode\":\"manual\",\"telemetry.telemetryLevel\":\"off\",\"python.languageServer\":\"Pylance\",\"python.analysis.typeCheckingMode\":\"off\",\"python.terminal.activateEnvironment\":true,\"jupyter.askForKernelRestart\":false,\"notebook.lineNumbers\":\"on\",\"[python]\":{\"editor.tabSize\":4,\"editor.insertSpaces\":true},\"[jupyter]\":{\"editor.fontSize\":24}}","extensions":"[{\"identifier\":{\"id\":\"ms-python.python\"},\"displayName\":\"ms-python.python\"},{\"identifier\":{\"id\":\"ms-python.vscode-pylance\"},\"displayName\":\"ms-python.vscode-pylance\"},{\"identifier\":{\"id\":\"ms-python.debugpy\"},\"displayName\":\"ms-python.debugpy\"},{\"identifier\":{\"id\":\"ms-toolsai.jupyter\"},\"displayName\":\"ms-toolsai.jupyter\"},{\"identifier\":{\"id\":\"ms-toolsai.jupyter-keymap\"},\"displayName\":\"ms-toolsai.jupyter-keymap\"},{\"identifier\":{\"id\":\"ms-toolsai.jupyter-renderers\"},\"displayName\":\"ms-toolsai.jupyter-renderers\"}]"}